{
	"App": {
		"AuthSigningKey": "Double frog said the acrobatic salamader flying through the air.",
		"AuthIssuer": "local",
		"AuthAudience": "All",
		"AllowedOrigins": "https://www.vuecore.dev;https://vuecore.dev;https://vuecore",
		"FoldersRoot": "App_Data"
	},
  "Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
  },
  "Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.AspNetCore": "Warning",
				"System": "Warning"
			}
		},
		"WriteTo": [
			{ "Name": "Console" },
			{ "Name": "File",
				"Args": {
					"path": "%VUECORE_LOG_PATH%",
					"rollingInterval": "Day"
				}
			}
		]
  }
}
